[gd_resource type="Resource" script_class="BoatStats" format=3]

[ext_resource type="Script" path="res://scripts/data/boat_stats.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"explorer"
display_name = "Лодка исследователя"
description = "Открывает путь из мангров в Ледяной фьорд. В прогулках на треть быстрее обычной лодки. Даёт +50% удачи вдали от родного озера. Бонус складывается с удочкой и приманкой."
price = 400
scouting_luck = 0.5
sailing_speed = 8.0
