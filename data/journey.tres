[gd_resource type="Resource" script_class="JourneyData" format=3]

[ext_resource type="Script" path="res://scripts/data/journey_data.gd" id="1"]

[resource]
script = ExtResource("1")
goals = Array[Dictionary]([{
"id": "first_catch", "title": "Первый улов", "hint": "Повернись к воде, удерживай и отпусти кнопку рыбалки.", "metric": "catches", "target": 1, "reward": 25
}, {
"id": "first_sale", "title": "На новую снасть", "hint": "Открой садок вверху экрана, выбери рыбу и подтверди продажу.", "metric": "sales", "target": 1, "reward": 25
}, {
"id": "three_species", "title": "Любопытный рыболов", "hint": "Поймай 3 разных вида. Время суток влияет на клёв.", "metric": "species", "target": 3, "reward": 60
}, {
"id": "new_rod", "title": "Хороший инструмент", "hint": "Купи вторую удочку у Луки на острове.", "metric": "rods", "target": 2, "reward": 40
}, {
"id": "first_meal", "title": "В дорогу с теплом", "hint": "Марта у огорода приготовит обычный улов для походного усиления.", "metric": "meals", "target": 1, "reward": 40
}, {
"id": "mangrove_visit", "title": "За горизонт", "hint": "Сядь в лодку у причала слева от дома.", "metric": "mangrove_visit", "target": 1, "reward": 50
}, {
"id": "ten_catches", "title": "Ещё один заброс", "hint": "Поймай 10 рыб. Рыбные места с пузырями ускоряют клёв.", "metric": "catches", "target": 10, "reward": 80
}, {
"id": "lake_collection", "title": "Знаток озера", "hint": "Открой все 6 озёрных видов. Ищи карпа на рассвете и закате.", "metric": "lake_species", "target": 6, "reward": 350
}, {
"id": "mangrove_collection", "title": "Секреты мангров", "hint": "Открой 4 разных вида в мангровых отмелях.", "metric": "mangrove_species", "target": 4, "reward": 300
}, {
"id": "mangrove_complete", "title": "Все оттенки отмелей", "hint": "Открой все 5 видов мангров. Луциан выходит на рассвете, закате и ночью.", "metric": "mangrove_species", "target": 5, "reward": 120
}, {
"id": "golden_trophy", "title": "Золотой трофей", "hint": "Поймай рыбу весом не меньше 85% диапазона её вида.", "metric": "trophies", "target": 1, "reward": 100
}, {
"id": "explorer_boat", "title": "Попутного ветра", "hint": "Улучши лодку у Луки, чтобы открыть путь на север.", "metric": "boat", "target": 1, "reward": 75
}, {
"id": "fjord_visit", "title": "Северный ветер", "hint": "В манграх найди восточный причал и отправляйся во фьорд.", "metric": "fjord_visit", "target": 1, "reward": 100
}, {
"id": "fjord_collection", "title": "Тайны холодных вод", "hint": "Открой все 3 вида Ледяного фьорда.", "metric": "fjord_species", "target": 3, "reward": 400
}, {
"id": "harbor_explorer", "title": "Истории трёх берегов", "hint": "Осмотри маяк, хижину лодочника и каменную арку. Записи появятся в открытиях.", "metric": "landmarks", "target": 3, "reward": 120
}, {
"id": "first_letter", "title": "Послание на воде", "hint": "Сядь в лодку и найди бутылку к северо-западу от причала озера. Подсказки — во вкладке «Письма».", "metric": "messages", "target": 1, "reward": 30
}, {
"id": "letters_home", "title": "Дорога домой", "hint": "Найди три письма в трёх водоёмах. На лодке появится флажок возвращения.", "metric": "messages", "target": 3, "reward": 90
}])
