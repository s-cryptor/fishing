[resource]
script = ExtResource("1")
id = &"boatkeepers_hut"
title = "Хижина лодочника"
habitat = &"mangrove"
description = "Сеть высохла на ветру, а у двери всё ещё стоят запасные вёсла. Внутри видна карта тёплых течений: кто-то обвёл места, где рыба собирается стаями.\n\nРядом приписка: «Не гонись за тенью. Бросай в маленькое кольцо — и дай воде успокоиться»."
clue = "Старая хижина прячется среди мангров в глубине острова."
position = Vector3(81, 0.5, 3.5)
kind = 1
