[resource]
script = ExtResource("1")
id = &"stone_sail"
title = "Каменный парус"
habitat = &"fjord"
description = "Ветер выгнул скалу, словно парус маленькой лодки. В сухой трещине спрятан выцветший вымпел с вышитой рыбой.\n\nНа обороте аккуратный почерк: «Даже самая сильная рыба готовится перед рывком. Смотри на поплавок и не бойся отпускать»."
clue = "За причалом фьорда видна снежная каменная арка."
position = Vector3(161, 0.5, 3.8)
kind = 2
