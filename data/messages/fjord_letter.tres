[gd_resource type="Resource" script_class="DriftMessageData" format=3]

[ext_resource type="Script" path="res://scripts/data/drift_message_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"fjord_letter"
title = "III · Там, где ждут"
habitat = &"fjord"
position = Vector3(144, 0.08, -16)
clue = "Во фьорде держись северо-западной стороны острова. Понадобится лодка исследователя."
body = "Бумага хрустит, будто тоже успела замёрзнуть. Последняя строчка написана особенно крупно.\n\n«Марта, сияние похоже на свет в нашем кухонном окне, только небо гораздо больше. Я думал, что ищу самый красивый берег. А искал тот, на котором меня ждут.\n\nЛука обещал сшить флажок по моему рисунку. Пусть на каждой лодке в гавани будет такой — чтобы никто не забывал дорогу домой. Э.»\n\nНа обороте — окончательный рисунок: зелёно-золотой флажок возвращения."
