[gd_resource type="Resource" script_class="DriftMessageData" format=3]

[ext_resource type="Script" path="res://scripts/data/drift_message_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"lake_letter"
title = "I · Чуть дальше причала"
habitat = &"lake"
position = Vector3(-18, 0.08, -18)
clue = "На родном озере отплыви от причала к северо-западу. Ищи золотой блик на воде."
body = "На листке — крошечный рисунок маяка. Чернила выцвели, но почерк ровный.\n\n«Марта, ты сказала, что я всё время смотрю вдаль и не замечаю собственного берега. Сегодня отплыл совсем ненадолго. С воды наш дом оказался красивее любого далёкого острова.\n\nЯ ещё зайду в мангры. Если письмо задержится, ищи следующее у их восточного берега. Э.»\n\nНа обороте кто-то нарисовал маленький зелёно-золотой флажок."
