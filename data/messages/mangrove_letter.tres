[gd_resource type="Resource" script_class="DriftMessageData" format=3]

[ext_resource type="Script" path="res://scripts/data/drift_message_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"mangrove_letter"
title = "II · Тёплая вахта"
habitat = &"mangrove"
position = Vector3(101, 0.08, 7)
clue = "В манграх обогни остров с востока и немного к югу. Бутылка качается за отмелью."
body = "Бутылка пахнет смолой. Внутри — сложенный вчетверо лист и сухой листок мангрового дерева.\n\n«Марта, ночью здесь слышно, как рыба касается поверхности. Старый лодочник пустил меня к очагу. Твоя уха осталась тёплой даже после долгой дороги.\n\nЗавтра поверну к фьорду. Хочу увидеть северное сияние хотя бы раз, а потом — домой. Оставлю последнюю записку у северо-западного берега. Э.»\n\nНа полях снова флажок. Теперь понятно: это не карта сокровищ, а обещание вернуться."
